# ==============================
# App
# ==============================
APP_NAME=FreelanceHub
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# ==============================
# Database
# ==============================
POSTGRES_USER=freelancehub
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=freelancehub_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://freelancehub:change_this_password@localhost:5432/freelancehub_db
ASYNC_DATABASE_URL=postgresql+asyncpg://freelancehub:change_this_password@localhost:5432/freelancehub_db

# ==============================
# JWT / Security
# ==============================
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# ==============================
# Redis / Celery
# ==============================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==============================
# Email (SMTP - use mailhog/mailtrap in dev)
# ==============================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@freelancehub.local
SMTP_TLS=false

# ==============================
# Google OAuth
# ==============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ==============================
# File Storage
# ==============================
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# AWS S3 (used when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=freelancehub-uploads
AWS_S3_ENDPOINT_URL=

# ==============================
# Payments (mock gateway - dev)
# ==============================
PAYMENT_GATEWAY=mock
PLATFORM_COMMISSION_PERCENT=10

# ==============================
# Rate Limiting
# ==============================
RATE_LIMIT_PER_MINUTE=60
